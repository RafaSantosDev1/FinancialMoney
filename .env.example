# FinSight environment variables — copy to `.env` and adjust.
# Never commit a real `.env` file.

# ---- PostgreSQL (docker-compose) ----
FINSIGHT_DB_NAME=finsight
FINSIGHT_DB_USER=finsight
FINSIGHT_DB_PASSWORD=change-me
FINSIGHT_DB_PORT=5432

# ---- API connection string ----
# Used by the ASP.NET Core API at runtime.
FINSIGHT_CONNECTION_STRING=Host=localhost;Port=5432;Database=finsight;Username=finsight;Password=change-me

# ---- CORS (comma separated list of allowed origins) ----
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=https://localhost:4200

# ---- Optional ----
# Overrides the in-memory fallback database name (tests/quick start).
FINSIGHT_INMEMORY_DB=finsight-dev
